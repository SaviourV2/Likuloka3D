{
  "firestore": { "rules": "firebase/firestore.rules", "indexes": "firebase/firestore.indexes.json" },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [{ "source": "/catalogue.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
